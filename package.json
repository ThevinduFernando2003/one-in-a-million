{
  "name": "one-in-a-million",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Every visitor gets a unique number, in order, until all one million are taken. Lock-free atomic Redis allocation on Next.js + Upstash.",
  "homepage": "https://one-in-a-million-nine.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThevinduFernando2003/one-in-a-million.git"
  },
  "bugs": {
    "url": "https://github.com/ThevinduFernando2003/one-in-a-million/issues"
  },
  "keywords": [
    "nextjs",
    "redis",
    "upstash",
    "lua",
    "concurrency",
    "lock-free",
    "vercel",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "redis:up": "docker compose up -d --wait",
    "redis:down": "docker compose down",
    "stress": "tsx scripts/stress.ts",
    "stress:local": "tsx scripts/stress-local.ts",
    "reset": "tsx scripts/reset.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run redis:up && npm run test && npm run build && npm run stress:local"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "^1.41.1",
    "canvas-confetti": "^1.9.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
