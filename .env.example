# Copy to .env.local for local development. All values are server-side only
# (none are prefixed with NEXT_PUBLIC_, so none reach the browser bundle).

# Upstash Redis REST credentials.
# Locally these point at the SRH container from docker-compose.yml.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=oiam-local-dev-token

# Fallbacks: the names Vercel Marketplace (Upstash for Redis) injects.
# Used only when the UPSTASH_* variables above are not set.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Hard ceiling. Values above 1000000 are clamped to 1000000.
MAX_TOKENS=1000000

# Optional: per-IP rate limit (requests per 10 seconds). Default 300.
# RATE_LIMIT_PER_10S=300

# Optional: comma-separated extra origins allowed to POST /api/token
# (the app's own origin is always allowed).
# ALLOWED_ORIGINS=https://example.com

# Optional: canonical site URL used for Open Graph metadata.
# SITE_URL=https://one-in-a-million.example
